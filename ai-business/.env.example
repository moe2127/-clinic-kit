# 初期値は未接続。本番でlocalモードを使わないでください。
APP_MODE=production
APP_URL=http://127.0.0.1:3000
# localモードでのみ必要（32文字以上、実際のランダム値に置換）
SESSION_SECRET=
LOCAL_OWNER_PASSWORD=
# サーバー側だけに設定。NEXT_PUBLIC_を付けない。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# JSON Schema出力とmax_completion_tokensに対応するモデル
OPENAI_MODEL=
# 利用モデルの最新単価（1MトークンあたりUSD）と予算用の為替レートを設定
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
USD_JPY=
BRAVE_SEARCH_API_KEY=
# 本番Node.js環境からPythonを直接起動せず、認証されたHTTPSワーカーを使用
PYTHON_WORKER_URL=
PYTHON_WORKER_TOKEN=
# CronのBearer認証。ランダムな32文字以上
CRON_SECRET=
# Gmail宛にも送れる通知配信サービス。送信ドメイン認証が必要
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=
NOTIFICATION_FROM=
